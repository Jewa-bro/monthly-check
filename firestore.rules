rules_version = '2';

// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 내용을 붙여넣고 '게시'.
// 회원(members) 문서 ID 는 두 가지다:
//   카카오 사용자  → kakao:<번호>  (uid 와 같다)
//   구글 사용자    → 이메일 소문자 (uid 가 무작위 글자라 알기 어려워서)
service cloud.firestore {
  match /databases/{database}/documents {

    function hasEmail() {
      return request.auth != null
          && 'email' in request.auth.token
          && request.auth.token.email != null;
    }
    function isMember() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/members/$(request.auth.uid))
        || (hasEmail()
            && exists(/databases/$(database)/documents/members/$(request.auth.token.email)))
      );
    }
    function me() {
      return exists(/databases/$(database)/documents/members/$(request.auth.uid))
        ? get(/databases/$(database)/documents/members/$(request.auth.uid)).data
        : get(/databases/$(database)/documents/members/$(request.auth.token.email)).data;
    }
    function isAdmin() {
      return isMember() && me().role == 'admin';
    }

    // 실적 — 본인 것만
    match /users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 회원 명단 — 본인 확인은 누구나(uid 또는 이메일 일치), 목록·수정은 관리자만
    match /members/{id} {
      allow get: if request.auth != null
              && (request.auth.uid == id || (hasEmail() && request.auth.token.email == id));
      allow read, write: if isAdmin();
    }

    // 조 — 같은 조 회원만 보고, 조원 명단은 그 조 조장(또는 관리자)만 고친다
    match /teams/{team} {
      allow read: if isAdmin() || (isMember() && me().team == team);
      allow write: if isAdmin()
                || (isMember() && me().role == 'leader' && me().team == team);

      // 주간 휴무 — 같은 조 회원이면 누구나 적고 지운다
      match /weeks/{week} {
        allow read, write: if isAdmin() || (isMember() && me().team == team);
      }
    }
  }
}
